# ==============================================================================
# candy_v2 — environment template
# ==============================================================================
# Copy this file, fill it in, and NEVER commit the result:
#
#   cp .env.example .env
#
# On bot-hosting.net, set these as environment variables in the panel instead of
# using a file. Both repos have their own copy of this template — they are NOT
# interchangeable. candy_web needs VITE_ variables and must never see the
# service_role key.
#
# Copy the whole block when configuring the host. A blank value is not the same
# as an unset variable, and the bot distinguishes them.
# ==============================================================================


# ==============================================================================
# 1. DISCORD  (required)
# ==============================================================================
# Developer Portal -> your application -> Bot -> Reset Token
# This token is full control of the bot. Treat it like a password.
DISCORD_TOKEN=

# Comma-separated guild IDs used to publish slash commands INSTANTLY during
# development. Global command sync can take up to an hour to propagate, which is
# painful while iterating.
#   - While developing: put your test server's ID here.
#   - In production:    leave EMPTY so commands publish globally.
# Example: 123456789012345678,987654321098765432
# Find a guild ID: Discord -> Settings -> Advanced -> Developer Mode ON, then
# right-click the server icon -> Copy Server ID.
DEV_GUILD_IDS=

# Fallback text-command prefix, used only before a guild's row is loaded.
# Per-guild prefixes live in the database (guild_settings.prefix) and are
# edited with /config general prefix or on the dashboard.
COMMAND_PREFIX=!


# ==============================================================================
# 2. SUPABASE  (required)
# ==============================================================================
# Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# SERVICE ROLE key. This BYPASSES Row Level Security, so it is a full-power
# credential: anyone holding it can read and write every row in the project.
#
#   - exists ONLY in this bot's host environment
#   - never goes in the frontend, never in git, never pasted into a chat
#   - rotate it immediately if it is ever exposed
#
# The dashboard deliberately uses the public anon key instead, and relies on RLS.
SUPABASE_SERVICE_KEY=


# ==============================================================================
# 3. BEHAVIOUR  (optional — defaults shown)
# ==============================================================================

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Rotated at ~2 MB, keeping 2 backups (the free host has only 512 MB of storage,
# so this deliberately stays small).
LOG_FILE=logs/candy.log

# Live config updates via Supabase Realtime.
#   true  -> dashboard/slash-command edits apply within seconds
#   false -> edits only apply after a restart (commands still work normally)
# Note: if the Realtime subscription cannot be established, the bot falls back
# to polling automatically rather than losing updates.
ENABLE_REALTIME=true

# How many days the bot may run before it reminds the owner to renew the host.
# bot-hosting.net requires a manual renewal every 4 days; miss it and the bot
# stops. The default of 3 leaves a day of headroom so the reminder arrives while
# there is still time to act.
#
# The bot CANNOT read the host's renewal timer — that lives on bot-hosting's
# side — so it measures its own uptime instead. A host restart resets the clock,
# which can only make the reminder later, never earlier.
#
# The reminder is sent as a DM to the bot owner (falling back to each guild's
# log channel if DMs are closed). After renewing, run `/config dev renewed` to
# reset the clock.
#
# Set to 0 to disable the reminder entirely.
ROTATION_REMINDER_DAYS=3


# ==============================================================================
# 4. GROQ — DELIBERATELY NOT CONFIGURED HERE
# ==============================================================================
# There is intentionally no GROQ_API_KEY variable in this file.
#
# The Groq key lives in SUPABASE SECRETS and is read only by the `chat` Edge
# Function. The bot calls that function over HTTPS and never sees the key.
#
#   supabase secrets set GROQ_API_KEY=gsk_your_key_here
#
# Why not here:
#   - bot-hosting.net requires manual renewal every 4 days. If the key were on
#     the bot, missing a renewal would kill AI chat outright. Behind the Edge
#     Function, the key survives bot downtime and the dashboard path still works.
#   - A key in this file lands in any environment dump or backup, and is one
#     careless `git add` away from being public.
#   - The dashboard needs AI too (prompt testing). One secret serves both.
#
# If you are tempted to add it here: don't. Add it as a Supabase secret instead.

# ==============================================================================
# END
# ==============================================================================
